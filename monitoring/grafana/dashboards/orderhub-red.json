          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(orderhub_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
