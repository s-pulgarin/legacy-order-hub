        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Peticiones en curso",
      "description": "Saturación: peticiones atendiéndose al mismo tiempo.",
      "datasource": {
