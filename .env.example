# Copia este archivo como .env y reemplaza los valores. El .env NO se versiona.
# Generar una clave:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Obligatoria. Firma los JWT y es la SECRET_KEY de Flask (mínimo 32 caracteres).
# La app se niega a arrancar con este valor de ejemplo.
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Base de datos. Si DATABASE_URL está definida se usa PostgreSQL; si no, SQLite
# en DATABASE_PATH. En docker-compose, DATABASE_URL la arma el propio compose.
DATABASE_PATH=orderhub.db
DATABASE_URL=

# Redis para la notificación asíncrona (RF-04.1). Vacío: no se encolan eventos.
# En docker-compose la arma el propio compose.
REDIS_URL=

# Vigencia del token de sesión en minutos (por defecto 30).
JWT_EXPIRES_MINUTES=30

# Servidor de desarrollo. Nunca actives FLASK_DEBUG en un entorno expuesto.
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Logs: nivel (DEBUG, INFO, WARNING, ERROR, CRITICAL) y formato (json o text).
# JSON es el formato para producción/contenedores; text es más legible en local.
LOG_LEVEL=INFO
LOG_FORMAT=json

# docker-compose: contraseña de PostgreSQL y del usuario admin de Grafana.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Contraseñas de los usuarios semilla "admin" (rol admin) y "juan" (rol client).
# Solo se usan si la tabla de usuarios está vacía; si se dejan vacías, no se crean.
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
